<import src="../question-pane.wxml" />

<view class="practice-shell" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <app-nav title="随机练习" back-home="{{true}}"></app-nav>

  <view wx:if="{{loading}}" class="empty">正在抽取题目...</view>
  <view wx:elif="{{!questions.length}}" class="empty">当前等级暂无题库</view>

  <block wx:else>
    <view class="question-slider">
      <view class="question-track {{slideTrackClass}}">
        <block wx:for="{{slidePanes}}" wx:key="key">
          <template is="question-pane" data="{{pane:item}}" />
        </block>
      </view>
    </view>

    <view class="random-tabbar">
      <view class="tool-item" bindtap="loadQuestions">
        <view class="refresh-icon"></view>
        <view>换一组</view>
      </view>
      <view class="progress-entry">
        <view class="progress-count">{{current + 1}}/{{questions.length}}</view>
        <view class="progress-label">{{result && result.correct ? '答对，自动下一题' : '左右滑动切换题目'}}</view>
      </view>
    </view>
  </block>
</view>
