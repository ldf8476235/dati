.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.question-card {
  padding: 30rpx;
}

.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.question-content {
  margin-top: 24rpx;
  font-size: 34rpx;
  line-height: 52rpx;
  font-weight: 700;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.option {
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border: 2rpx solid #d9deea;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: left;
  color: #1a1b22;
  font-size: 30rpx;
  line-height: 44rpx;
}

.option.selected {
  border-color: #003fa3;
  background: #eef3ff;
}

.option.correct {
  border-color: #2e7d32;
  background: #e7f6ea;
  color: #1b5e20;
}

.option.wrong {
  border-color: #ba1a1a;
  background: #ffdad6;
  color: #93000a;
}

.result-card {
  margin-top: 24rpx;
  padding: 28rpx;
  line-height: 42rpx;
}

.result-card.ok {
  border-left: 8rpx solid #2e7d32;
}

.result-card.bad {
  border-left: 8rpx solid #ba1a1a;
}

.result-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.analysis {
  margin: 12rpx 0;
  color: #434653;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 18rpx;
  margin-top: 28rpx;
}

.mini-button {
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #003fa3;
  background: #dae1ff;
  font-size: 24rpx;
  font-weight: 800;
}

.actions.single {
  grid-template-columns: 1fr;
}
