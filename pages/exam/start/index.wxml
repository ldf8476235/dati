<view class="page exam-start">
  <app-nav title="模拟考试" back-home="{{true}}"></app-nav>
  <view class="section-title">模拟考试</view>
  <view class="muted intro">100 题，60 分钟，系统按当前等级随机组卷。</view>

  <view class="card rules">
    <view class="rule">
      <text class="rule-num">80</text>
      <text class="rule-label">选择题</text>
    </view>
    <view class="rule">
      <text class="rule-num">20</text>
      <text class="rule-label">判断题</text>
    </view>
    <view class="rule">
      <text class="rule-num">100</text>
      <text class="rule-label">总分</text>
    </view>
  </view>

  <picker value="{{levelIndex}}" range="{{levelNames}}" bindchange="onLevelChange">
    <view class="picker-control">{{levelNames[levelIndex] || '选择等级'}}</view>
  </picker>

  <button class="primary-button start-button" loading="{{starting}}" bindtap="startExam">{{starting ? '正在组卷' : '开始考试'}}</button>
  <button class="ghost-button history-button" bindtap="goHistory">考试历史</button>
</view>
