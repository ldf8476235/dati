<import src="../../practice/question-pane.wxml" />

<view class="practice-shell exam-detail-shell">
  <app-nav title="考试答题" back-home="{{true}}"></app-nav>

  <view class="exam-status">
    <view>
      <view class="exam-level">{{exam.levelName}}</view>
      <view class="exam-meta">已答 {{answeredCount}} / {{questions.length}}</view>
    </view>
    <view class="timer">{{remainingText}}</view>
  </view>

  <view class="progress">
    <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
  </view>

  <scroll-view class="number-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="number-row">
      <button wx:for="{{questions}}" wx:key="id" data-index="{{index}}" bindtap="goQuestion" class="num {{current === index ? 'active' : ''}} {{item.answered ? 'done' : ''}}">{{index + 1}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{currentPane}}" class="question-single">
    <template is="question-pane" data="{{pane:currentPane}}" />
  </view>

  <view class="exam-tabbar">
    <view class="nav-action {{current <= 0 ? 'disabled' : ''}}" bindtap="prevQuestion">上一题</view>
    <view class="submit-action" bindtap="confirmSubmit">{{submitting ? '交卷中' : '交卷'}}</view>
    <view class="nav-action {{current >= questions.length - 1 ? 'disabled' : ''}}" bindtap="nextQuestion">下一题</view>
  </view>
</view>
