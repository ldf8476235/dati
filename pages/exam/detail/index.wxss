@import "../../practice/sequence/index.wxss";

.exam-detail-shell {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.exam-status {
  padding: 18rpx 24rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.exam-level {
  color: #202631;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.exam-meta {
  margin-top: 4rpx;
  color: #687082;
  font-size: 23rpx;
  line-height: 30rpx;
}

.timer {
  min-width: 126rpx;
  min-height: 58rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #0b5bd3;
  font-size: 28rpx;
  font-weight: 900;
}

.progress {
  height: 8rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 999rpx;
  overflow: hidden;
  background: #edf0f5;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #0b5bd3;
}

.question-slider {
  margin-top: 22rpx;
}

.exam-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  min-height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-shadow: 0 -1rpx 0 rgba(16, 24, 40, 0.08);
}

.submit-action {
  min-height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 900;
}

.submit-action {
  width: 100%;
  color: #ffffff;
  background: #0b5bd3;
}
