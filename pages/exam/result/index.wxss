.result-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.result-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding-bottom: calc(116rpx + env(safe-area-inset-bottom));
}

.score-card {
  padding: 36rpx;
  text-align: center;
}

.score {
  margin: 12rpx 0;
  font-size: 96rpx;
  line-height: 112rpx;
  font-weight: 900;
}

.score-good {
  color: #2e7d32;
}

.score-warn {
  color: #d97706;
}

.score-bad {
  color: #ba1a1a;
}

.summary {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.summary-item {
  flex: 1;
  min-width: 0;
  min-height: 116rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
}

.summary-num {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
}

.summary-num.ok,
.ok-text {
  color: #2e7d32;
}

.summary-num.bad,
.bad-text {
  color: #ba1a1a;
}

.summary-label {
  display: block;
  margin-top: 6rpx;
  color: #687082;
  font-size: 24rpx;
}

.detail-title {
  margin-top: 32rpx;
  margin-bottom: 18rpx;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 0;
}

.detail-item {
  padding: 26rpx;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 900;
}

.detail-question {
  margin: 18rpx 0;
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.answer-row {
  margin-top: 8rpx;
  color: #434653;
  font-size: 26rpx;
}

.analysis {
  margin-top: 12rpx;
  color: #687082;
  line-height: 38rpx;
}

.bottom-actions {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  z-index: 20;
}

.bottom-actions button {
  flex: 1;
  min-width: 0;
}
