<view class="page search-page">
  <app-nav title="搜索" back-home="{{true}}"></app-nav>

  <view class="search-header">
    <view class="search-row">
      <view class="search-bar">
        <view class="search-icon"></view>
        <input class="search-input" value="{{keyword}}" placeholder="请输入" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
        <view wx:if="{{keyword}}" class="clear-icon" bindtap="clearKeyword"></view>
      </view>
      <view class="search-action" bindtap="search">搜索</view>
    </view>

    <view class="type-tabs">
      <view wx:for="{{types}}" wx:key="value" bindtap="onTypeTap" data-type="{{item.value}}" class="type-tab {{type === item.value ? 'active' : ''}}">{{item.label}}</view>
    </view>
  </view>

  <scroll-view class="result-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="empty">正在加载题目...</view>
    <view wx:elif="{{!items.length}}" class="empty">{{keyword ? '未找到匹配题目' : '当前等级暂无题目'}}</view>

    <view wx:else class="result-list">
      <view wx:for="{{items}}" wx:key="id" class="question-item">
        <view class="question-title">
          <text class="type-badge">{{item.type === 'single_choice' ? '单选' : '判断'}}</text>
          <text>{{item.content}}（　）。（{{item.typeHint}}）</text>
        </view>
        <view class="option-lines">
          <view wx:for="{{item.optionItems}}" wx:for-item="option" wx:key="value" class="option-line">{{option.value}}.{{option.displayLabel}}</view>
        </view>
        <view class="answer-panel">
          <view class="answer-top">
            <view class="answer-line">
              <text>答案</text>
              <text class="answer-value">{{item.answerText}}</text>
            </view>
            <view class="copy-button" data-index="{{index}}" catchtap="copyQuestion">复制</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
