<import src="../../practice/question-pane.wxml" />

<view class="practice-shell search-shell">
  <app-nav title="试题搜索" back-home="{{true}}"></app-nav>

  <view wx:if="{{!active}}" class="list-head">
    <view class="module-title">试题搜索</view>
    <view class="module-desc">按题干关键词定位当前等级题目</view>
  </view>

  <view wx:if="{{!active}}" class="search-bar">
    <input class="search-input" value="{{keyword}}" placeholder="输入题干关键词" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
    <button class="search-button" bindtap="search">搜索</button>
  </view>

  <view wx:if="{{!active}}" class="filters">
    <picker value="{{levelIndex}}" range="{{levelNames}}" bindchange="onLevelChange">
      <view class="picker-control">
        <text>{{levelNames[levelIndex] || '选择等级'}}</text>
        <view class="picker-arrow"></view>
      </view>
    </picker>
    <view class="segmented">
      <view wx:for="{{types}}" wx:key="value" bindtap="onTypeTap" data-type="{{item.value}}" class="segment {{type === item.value ? 'active' : ''}}">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{searching}}" class="empty">正在搜索...</view>

  <view wx:elif="{{active}}" class="detail-mode">
    <view class="detail-top">
      <view class="back-link" bindtap="closeQuestion">返回结果</view>
      <view class="detail-meta">搜索结果</view>
    </view>
    <template is="question-pane" data="{{pane:activePane}}" />
    <view class="detail-actions">
      <view wx:if="{{!result}}" class="submit-action {{selected ? '' : 'disabled'}}" bindtap="submitAnswer">提交答案</view>
      <view wx:else class="submit-action ghost" bindtap="closeQuestion">返回结果</view>
    </view>
  </view>

  <view wx:elif="{{!items.length}}" class="empty">{{keyword ? '未找到匹配题目' : '输入关键词后开始搜索'}}</view>

  <view wx:else class="list">
    <view class="count">找到 {{total}} 道题</view>
    <view wx:for="{{items}}" wx:key="id" class="list-item" data-index="{{index}}" bindtap="openQuestion">
      <view class="item-title">{{item.content}}</view>
      <view class="item-meta">{{item.typeLabel}}</view>
    </view>
  </view>
</view>
