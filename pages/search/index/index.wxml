<view class="page">
  <app-nav title="试题搜索" back-home="{{true}}"></app-nav>
  <view class="section-title">试题搜索</view>
  <view class="search-bar">
    <input class="search-input" value="{{keyword}}" placeholder="输入题干关键词" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
    <button class="search-button" bindtap="search">搜索</button>
  </view>

  <view class="filters">
    <picker value="{{levelIndex}}" range="{{levelNames}}" bindchange="onLevelChange">
      <view class="picker-control">{{levelNames[levelIndex] || '选择等级'}}</view>
    </picker>
    <view class="segmented">
      <view wx:for="{{types}}" wx:key="value" bindtap="onTypeTap" data-type="{{item.value}}" class="segment {{type === item.value ? 'active' : ''}}">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{searching}}" class="empty">正在搜索...</view>
  <view wx:elif="{{active}}" class="detail">
    <button class="back-link" bindtap="closeQuestion">返回结果</button>
    <view class="card question-card">
      <view class="question-meta">
        <text class="tag">{{active.typeLabel}}</text>
        <text class="muted">搜索结果</text>
      </view>
      <view class="question-content">{{active.content}}</view>
    </view>
    <view class="options">
      <button wx:for="{{active.optionItems}}" wx:key="value" class="option {{selected === item.value ? 'selected' : ''}} {{result && result.correctAnswer === item.value ? 'correct' : ''}} {{result && selected === item.value && !result.correct ? 'wrong' : ''}}" data-value="{{item.value}}" bindtap="selectAnswer">{{item.label}}</button>
    </view>
    <view wx:if="{{result}}" class="card result-card {{result.correct ? 'ok' : 'bad'}}">
      <view class="result-title">{{result.correct ? '回答正确' : '回答错误'}}</view>
      <view>正确答案：{{result.correctAnswer === 'true' ? '正确' : result.correctAnswer === 'false' ? '错误' : result.correctAnswer}}</view>
      <view wx:if="{{result.analysis}}" class="analysis">{{result.analysis}}</view>
    </view>
    <button wx:if="{{!result}}" class="primary-button submit" bindtap="submitAnswer">提交答案</button>
  </view>
  <view wx:elif="{{!items.length}}" class="empty">输入关键词后开始搜索</view>
  <view wx:else class="list">
    <view class="muted count">找到 {{total}} 道题</view>
    <button wx:for="{{items}}" wx:key="id" class="card list-item" data-index="{{index}}" bindtap="openQuestion">
      <view class="item-title">{{item.content}}</view>
      <view class="item-meta">{{item.typeLabel}}</view>
    </button>
  </view>
</view>
