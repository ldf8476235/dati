@import "../../practice/sequence/index.wxss";

.list-shell {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.list-head {
  padding-top: 20rpx;
  margin-bottom: 22rpx;
}

.module-title {
  color: #202631;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 900;
}

.module-desc {
  margin-top: 6rpx;
  color: #687082;
  font-size: 24rpx;
  line-height: 32rpx;
}

.filters {
  margin-bottom: 24rpx;
}

.picker-control {
  min-height: 84rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border: 2rpx solid #edf0f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  color: #202631;
  font-weight: 900;
}

.picker-arrow {
  width: 14rpx;
  height: 14rpx;
  box-sizing: border-box;
  border-right: 4rpx solid #0b5bd3;
  border-bottom: 4rpx solid #0b5bd3;
  transform: translateY(-3rpx) rotate(45deg);
}

.segmented {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #edf0f5;
}

.segment {
  min-height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5b6374;
  font-weight: 900;
}

.segment.active {
  color: #ffffff;
  background: #0b5bd3;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 40rpx;
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.item-title {
  color: #202631;
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.item-meta {
  margin-top: 10rpx;
  color: #687082;
  font-size: 23rpx;
  line-height: 30rpx;
}

.detail-mode {
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
}

.detail-top {
  padding: 18rpx 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-link,
.detail-meta {
  color: #687082;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.back-link {
  color: #0b5bd3;
}

.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  min-height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 -1rpx 0 rgba(16, 24, 40, 0.08);
}

.submit-action {
  min-height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #0b5bd3;
  font-size: 28rpx;
  font-weight: 900;
}

.submit-action.disabled {
  color: #98a2b3;
  background: #edf0f5;
}

.submit-action.ghost {
  color: #202631;
  border: 2rpx solid #edf0f5;
  background: #ffffff;
}
