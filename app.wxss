page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #1a1b22;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.4;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(120rpx + env(safe-area-inset-top)) 32rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.muted {
  color: #687082;
}

.primary-button,
.ghost-button,
.danger-button {
  min-height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #003fa3;
}

.ghost-button {
  color: #003fa3;
  border: 2rpx solid #b8c7ee;
  background: #ffffff;
}

.danger-button {
  color: #ffffff;
  background: #ba1a1a;
}

.card {
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(43, 88, 189, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1b22;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  color: #003fa3;
  background: #dae1ff;
  font-size: 22rpx;
  font-weight: 700;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #687082;
}
